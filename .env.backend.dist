# Supabase configuration (replace with your actual Supabase project credentials)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-key-here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key-here

# MyAnimeList OAuth credentials (get these from MAL Developer portal)
MAL_CLIENT_ID=YOUR_MAL_CLIENT_ID
MAL_CLIENT_SECRET=YOUR_MAL_CLIENT_SECRET

# Encryption key for storing MAL tokens
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY

# Debug mode
DEBUG=True
