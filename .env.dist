# Docker Compose variable substitution — copy to .env and fill in values.
# This file is loaded automatically by Docker Compose for variable substitution
# in compose.yml. It is NOT passed into containers directly.

POSTGRES_DB=ihys
POSTGRES_USER=ihys
POSTGRES_PASSWORD=CHANGE_ME

# Domain used by Caddy for TLS and routing (no https:// prefix)
DOMAIN=yourdomain.com

# Umami analytics (self-hosted)
UMAMI_POSTGRES_DB=umami
UMAMI_POSTGRES_USER=umami
UMAMI_POSTGRES_PASSWORD=CHANGE_ME
# Random string used by Umami to sign JWTs — generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
UMAMI_APP_SECRET=CHANGE_ME
