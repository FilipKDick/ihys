# Docker Compose variable substitution — copy to .env and fill in values.
# This file is loaded automatically by Docker Compose for variable substitution
# in compose.yml. It is NOT passed into containers directly.

POSTGRES_DB=ihys
POSTGRES_USER=ihys
POSTGRES_PASSWORD=CHANGE_ME

# Domain used by Caddy for TLS and routing (no https:// prefix)
DOMAIN=yourdomain.com
